# systemd service: keeps the listener running and restarts it after crashes or reboots.
# Install (on the server, from the repo folder):
#   sudo cp deploy/memedashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now memedashboard
# Logs: journalctl -u memedashboard -f
[Unit]
Description=Pump.fun dashboard live listener
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/memedashboard
Environment=PORT=3000
Environment=PUBLISH_MINUTES=30
# Environment=SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
ExecStart=/usr/bin/node scripts/listen.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
